# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# ---------------------------------------------------------------- PostgreSQL (docker compose)
POSTGRES_USER=aisre
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aisre

# ---------------------------------------------------------------- Host ports (change if they clash)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8010
WEB_HOST_PORT=8090

# ---------------------------------------------------------------- Backend (AI_SRE_* settings)
# Used when running the API or tests on the host (uv run poe api / migrate / test-integration).
# Inside Docker, compose builds these URLs from the values above.
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and stalls ~2s.
AI_SRE_ENVIRONMENT=development
AI_SRE_LOG_LEVEL=INFO
# AI_SRE_LOG_FORMAT=console        # console | json (default: console in development)
AI_SRE_DATABASE_URL=postgresql+asyncpg://aisre:change-me-local-only@127.0.0.1:5432/aisre
AI_SRE_REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------- LLM
# Development uses the Gemini free tier. Get a key at https://aistudio.google.com/apikey
# Free-tier quotas are small and per model; check your limits in AI Studio.
# Free-tier prompts may be used by Google to improve its products: synthetic data only.
AI_SRE_LLM_PROVIDER=gemini
AI_SRE_GEMINI_API_KEY=
AI_SRE_GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------- Simulated environment (docker-compose.sim.yml)
# All optional; defaults shown. The simulated environment is local-only synthetic data.
# SIM_LOADGEN_RPS=10
# SIM_POSTGRES_PASSWORD=simulated-only
# SIM_GRAFANA_ADMIN_PASSWORD=simulated-only
# SIM_GATEWAY_PORT=8200
# SIM_ORDERS_PORT=8201
# SIM_DEPLOYER_PORT=8202
# SIM_CHAOS_PORT=8210
# SIM_PROMETHEUS_PORT=9090
# SIM_LOKI_PORT=3100
# SIM_GRAFANA_PORT=3000
# SIM_POSTGRES_PORT=55432               # read-only SRE access (role sre_readonly)
# SIM_SRE_READONLY_PASSWORD=sre-readonly-sim

# ---------------------------------------------------------------- MCP tool servers (Phase 3, docs/mcp.md)
# Bearer tokens. Read: read-only servers. Remediation: /mcp/remediation. Admin: human approvals.
# Change all four (and the approval secret) for anything beyond local development.
AI_SRE_MCP_READ_TOKEN=dev-mcp-read-token
AI_SRE_MCP_REMEDIATION_TOKEN=dev-mcp-remediation-token
AI_SRE_MCP_ADMIN_TOKEN=dev-mcp-admin-token
AI_SRE_MCP_APPROVAL_SECRET=dev-mcp-approval-secret-change-me
# Remediation (state-changing) tools refuse to run unless this is true.
AI_SRE_MCP_REMEDIATION_ENABLED=false
# MCP_HOST_PORT=8300
